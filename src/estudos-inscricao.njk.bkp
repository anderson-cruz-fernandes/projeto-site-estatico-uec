            const LINK_ANTIGO = "https://forms.gle/VpsS2PV3bqHTfccJA";
            const LINK_NOVO   = "https://forms.gle/dE6pbxinSaeLHg9dA";

            const destino = new Date() < new Date(DATA_TROCA)
                ? LINK_ANTIGO
                : LINK_NOVO;

            window.location.replace(destino);
      </script>
